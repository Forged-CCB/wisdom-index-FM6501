{
  "name": "forge-and-field",
  "version": "0.1.0",
  "description": "Bible study and teaching-prep app",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "user:add": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/user-cli.ts add",
    "user:password": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/user-cli.ts password",
    "typecheck": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
